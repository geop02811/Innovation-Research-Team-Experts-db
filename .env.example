POSTGRES_DB=expert_db
POSTGRES_USER=expert_app
POSTGRES_PASSWORD=change-this-database-password
# Existing Docker volume that holds the database (see README > Backups).
POSTGRES_VOLUME=innovation-research-team-experts-db_expertdb_data
# Daily pg_dump backups are written here and kept for BACKUP_KEEP_DAYS.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000

FRONTEND_PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:3000

SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000

APP_PASSWORD_RESET_OTP_EXPIRATION_MINUTES=10
APP_PASSWORD_RESET_MAIL_FROM=no-reply@localhost

# Optional SMTP settings for password-reset emails. If omitted, reset OTPs are logged by the backend for local testing.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=username@example.com
# SPRING_MAIL_PASSWORD=change-this-mail-password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true